{
  "$schema": "https://railway.app/schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfile": "Dockerfile"
  },
  "deploy": {
    "numReplicas": 1,
    "sleepApplication": false,
    "restartPolicyMaxRetries": 0,
    "ports": [
      {
        "startPort": 8998,
        "endPort": 8998
      }
    ]
  },
  "env": {
    "DOPPLER_PROJECT": "altro",
    "DOPPLER_CONFIG": "prd",
    "PYTHONUNBUFFERED": "1",
    "NO_TORCH_COMPILE": "1"
  }
}

